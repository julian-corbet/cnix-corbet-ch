{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnix.corbet.ch/schema/release-attestation.schema.json",
  "title": "cnix adversarial release attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_sha256",
    "verdict",
    "uncertainty",
    "summary",
    "findings",
    "reviewed_risks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "enum": ["allow", "deny", "uncertain"]
    },
    "uncertainty": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "path", "evidence", "rationale"],
        "properties": {
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "reviewed_risks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
