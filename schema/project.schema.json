{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnix.corbet.ch/schema/project.schema.json",
  "title": "cnix public project concept",
  "type": "object",
  "required": [
    "type",
    "title",
    "description",
    "cnix_id",
    "status",
    "showcase",
    "sources"
  ],
  "properties": {
    "type": { "const": "cnix/project" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "cnix_id": {
      "type": "string",
      "pattern": "^nix[a-z0-9-]+$"
    },
    "resource": { "type": "string", "format": "uri" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "status": { "enum": ["draft", "stable", "deprecated"] },
    "showcase": {
      "type": "object",
      "required": ["hostname", "tagline", "audience", "accent"],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^nix[a-z0-9-]+\\.corbet\\.ch$"
        },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 140 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 240 },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "related_projects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^nix[a-z0-9-]+$"
          },
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "stale_after": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "verified": {
      "oneOf": [
        { "$ref": "#/$defs/verification" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/verification" },
          "minItems": 1
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "last_modified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": true
      }
    },
    "cnix": {
      "type": "object",
      "properties": {
        "nixea_id": { "type": "string", "minLength": 1 },
        "maturity": {
          "enum": ["idea", "pre-alpha", "alpha", "beta", "stable"]
        },
        "dogfooded": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
